{
  "name": "@robo-journey/compile-service",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles Arduino sketches to firmware via arduino-cli, and maps compiler diagnostics back to source lines.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "image:build": "docker build -t robo-journey/arduino-cli:latest .",
    "fixtures:build": "npm run build && node dist/build-fixtures.js",
    "start": "node --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@robo-journey/sim-core": "*"
  }
}
