{
  "name": "@robo-journey/compile-service",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles Arduino sketches via arduino-cli and extracts component manifests from datasheets. Holds the API key so the browser never sees it.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "image:build": "docker build -t robo-journey/arduino-cli:latest .",
    "fixtures:build": "npm run build && node dist/build-fixtures.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "10.1.3",
    "@robo-journey/accounts": "*",
    "@robo-journey/datasheet": "*",
    "@robo-journey/parts": "*",
    "fastify": "^5.2.0",
    "ioredis": "6.0.0",
    "nodemailer": "9.0.5"
  },
  "devDependencies": {
    "@robo-journey/sim-core": "*"
  }
}
