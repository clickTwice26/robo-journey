# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Gemini API key, used to extract component manifests from datasheets.
# Get one at https://aistudio.google.com/apikey
#
# The key is read by the compile service only. It is never sent to the browser: the app POSTs the
# datasheet to /api/datasheet/extract and the service makes the model call. Putting the key in a
# frontend bundle would publish it.
GEMINI_API_KEY=

# Optional: override the extraction model. Defaults to gemini-3.7-flash.
# GEMINI_MODEL=gemini-2.5-pro

# Ports. Chosen away from the crowded defaults (3000, 5000, 5173, 8080) so this project can run
# beside others without a collision. Change them here if 286xx is taken on your machine -- and
# update .claude/launch.json to match, since that file cannot read this one.
RJ_SERVICE_PORT=28610
RJ_STUDIO_PORT=28611

# Where the account database lives. Defaults to robo-journey.db beside the project.
# Contains password hashes and session tokens: it is gitignored, and should stay that way.
# RJ_DATABASE=robo-journey.db
