# Copy to `.env` and fill in. `.env` is gitignored and never enters an image.
#
#   cp .env.example .env && docker compose up --build

# --- Required -------------------------------------------------------------------------------------

# Postgres. Generate something long rather than choosing one:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Optional -------------------------------------------------------------------------------------

POSTGRES_USER=robo
POSTGRES_DB=robo_journey

# Where the stack is published on the host. Loopback only, by design.
RJ_PUBLISH_PORT=28610

# Capacity policy. Ten people at once, an hour each, and a seat nobody has touched for two minutes
# passes to the next person in line.
RJ_ACCESS_CAPACITY=10
RJ_ACCESS_SESSION_MINUTES=60
RJ_ACCESS_IDLE_MINUTES=2

# Bounds on the wait between turns, not a fixed figure. The actual wait comes from how many people
# are queuing when a seat is given up -- the minimum when nobody is waiting, rising toward the
# maximum as the queue lengthens, and shortening again if the queue clears. A cooldown exists to
# stop one person cycling through a seat forever, and that only matters when somebody else wants it.
RJ_ACCESS_COOLDOWN_MIN_MINUTES=1
RJ_ACCESS_COOLDOWN_MAX_MINUTES=20

# --- Email ----------------------------------------------------------------------------------------
# Confirming an address is what makes the queue mean anything: accounts are free, so a per-account
# cooldown is only a limit if an account costs something to make, and a mailbox is that cost.
#
# With no SMTP_HOST set, links are printed to the service log instead of sent. That is how a
# local checkout works without a mail account -- register, read the link out of `npm run
# stack:logs`, and click it. In production the service refuses to start in that state, because a
# deployment that demands confirmation and cannot send it is one nobody can ever get into.

# Where the app is reached from. The links in outgoing mail are built from it, so it cannot be
# guessed from a request -- a Host header is attacker-controlled, and taking the link's origin from
# one is how a verification mail ends up pointing at somebody else's site.
RJ_PUBLIC_URL=http://localhost:28610

SMTP_HOST=
# 465 is implicit TLS and is inferred as such; anything else uses STARTTLS, which is required
# rather than optional, so credentials are never sent in the clear.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=robo-journey <no-reply@example.com>

# Set to false only to run without a mail server at all.
RJ_REQUIRE_VERIFIED_EMAIL=true

# --- Datasheet extraction ----------------------------------------------------------------------
# Without it the feature reports itself unavailable and everything else works. The key stays on the
# service and is never sent to the browser.
GEMINI_API_KEY=

LOG_LEVEL=info

# --- Running the service outside Compose ----------------------------------------------------------
# Only needed for `npm run service` against `npm run stack:dev`. Inside Compose these are set for
# you and point at the service names rather than at localhost.
# DATABASE_URL=postgres://robo:password@127.0.0.1:28632/robo_journey
# REDIS_URL=redis://127.0.0.1:28633
