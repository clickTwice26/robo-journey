# Copy to `.env` and fill in. `.env` is gitignored and never enters an image.
#
#   cp .env.example .env && docker compose up --build

# --- Required -------------------------------------------------------------------------------------

# Postgres. Generate something long rather than choosing one:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Optional -------------------------------------------------------------------------------------

POSTGRES_USER=robo
POSTGRES_DB=robo_journey

# Where the stack is published on the host. Loopback only, by design.
RJ_PUBLISH_PORT=28610

# Capacity policy. Ten people at once, an hour each, twenty minutes between turns, and a seat that
# nobody has touched for two minutes passes to the next person in line.
RJ_ACCESS_CAPACITY=10
RJ_ACCESS_SESSION_MINUTES=60
RJ_ACCESS_COOLDOWN_MINUTES=20
RJ_ACCESS_IDLE_MINUTES=2

# Datasheet extraction. Without it the feature reports itself unavailable and everything else
# works. The key stays on the service and is never sent to the browser.
GEMINI_API_KEY=

LOG_LEVEL=info

# --- Running the service outside Compose ----------------------------------------------------------
# Only needed for `npm run service` against `npm run stack:dev`. Inside Compose these are set for
# you and point at the service names rather than at localhost.
# DATABASE_URL=postgres://robo:password@127.0.0.1:28632/robo_journey
# REDIS_URL=redis://127.0.0.1:28633
